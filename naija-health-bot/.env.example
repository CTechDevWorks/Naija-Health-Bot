# Copy to .env and fill in. Never commit .env.
# Restart Expo after changing any of these (they are read when Expo starts).
#
# Everything here is compiled into the app and can be read by anyone who has
# it, so only public values belong in this file.

# The 9ja Health API (FastAPI). Local: http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=

# ── Weather (OpenWeather Current Weather Data) ──
# Free key: https://openweathermap.org/api → Current Weather Data
# EXPO_PUBLIC_* values are baked into the app bundle — fine for a free demo key;
# for production, proxy weather through the backend instead.
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# ── Accounts (optional) ──
# Leave both blank to run without sign-in; the app then hides it.
# Project URL, e.g. https://abcdefgh.supabase.co  (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
# The public "anon" / publishable key ONLY.
# Never put the service_role / secret key here: it would give every user of the
# app full access to the database.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
