{
  "expo": {
    "name": "9ja Health",
    "slug": "naija-health-bot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo-placeholder.jpeg",
    "scheme": "naijahealth",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5ECD4",
        "foregroundImage": "./assets/brand/logo-placeholder.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/logo-placeholder.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5ECD4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow 9ja Health to use your location to show the health outlook for your area. You can choose your state manually instead."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
