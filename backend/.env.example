# Copy to .env and fill in. Never commit .env.

# ── BluesMinds (OpenAI-compatible gateway) ──
# Console: https://api.bluesminds.com/console/token
# Required. While blank, the service starts but /api/v1/chat answers 503.
BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
# Primary model; ordered fallbacks are tried automatically on 4xx/5xx/timeouts.
BLUESMINDS_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
BLUESMINDS_FALLBACK_MODELS=openai/gpt-oss-20b,gpt-5.5

# ── Generation ──
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_S=90

# ── Guardrail limits ──
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_HISTORY_MESSAGES=20

# ── Supabase (optional — only if sign-in is added to the app) ──
# Leave both blank while the app has no accounts; every caller is then anonymous.
SUPABASE_URL=
# Only for legacy HS256 projects (Project Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=

# ── Rate limits (requests per window; anonymous callers are counted per IP) ──
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW_S=60
RATE_LIMIT_ANON=10
RATE_LIMIT_ANON_WINDOW_S=60

# ── CORS (browser clients only, e.g. Expo web; native apps ignore it) ──
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
