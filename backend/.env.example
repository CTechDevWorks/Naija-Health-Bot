# Copy to .env and fill in. Never commit .env.

# ── BluesMinds (OpenAI-compatible gateway) ──
# Console: https://api.bluesminds.com/console/token
# Required. While blank, the service starts but /api/v1/chat answers 503.
BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
# Primary model; ordered fallbacks are tried automatically on 4xx/5xx/timeouts.
BLUESMINDS_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
BLUESMINDS_FALLBACK_MODELS=openai/gpt-oss-20b,gpt-5.5

# ── Generation ──
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_S=90

# ── Guardrail limits ──
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_HISTORY_MESSAGES=20

# ── Supabase (accounts and saved conversations) ──
# Sign-in is optional in the app. While these are blank every caller is a guest:
# the chat works and nothing is saved.
# Project URL, e.g. https://abcdefgh.supabase.co  (Project Settings → API)
SUPABASE_URL=
# The public "anon" / publishable key (Project Settings → API keys). The same
# value goes in the app's EXPO_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# Server only. Needed to load the malaria knowledge base and to search it.
# Project Settings → API keys → service_role. Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects (Project Settings → API → JWT Secret).
# Leave blank for current projects, which sign tokens with ES256.
SUPABASE_JWT_SECRET=

# ── RAG (knowledge search) ──
# Cosine similarity floor (0–1) and how many passages to give the model.
RAG_MATCH_THRESHOLD=0.5
RAG_MATCH_COUNT=4

# ── Rate limits (requests per window; anonymous callers are counted per IP) ──
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW_S=60
RATE_LIMIT_ANON=10
RATE_LIMIT_ANON_WINDOW_S=60
# Listing / opening / deleting saved conversations, per RATE_LIMIT_AUTH_WINDOW_S.
RATE_LIMIT_HISTORY=60

# ── Keep-alive (free Render hosting) ──
# On Render the service pings its own /api/v1/health on this interval so it does
# not go to sleep. It is off locally (it needs Render's RENDER_EXTERNAL_URL).
# Set to 0 to turn it off.
KEEP_ALIVE_INTERVAL_S=300

# ── CORS (browser clients only, e.g. Expo web; native apps ignore it) ──
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083

# ── Daily health-updates job ──
# Shared secret for POST /api/v1/jobs/daily-health-updates (Make.com / cron).
# Send it as header X-Job-Secret. Leave blank only for local testing.
UPDATES_JOB_SECRET=
# In-process 07:00 Africa/Lagos scheduler. Blank = on when RENDER_EXTERNAL_URL
# is set. Use 1/0 to force on/off locally.
UPDATES_SCHEDULER_ENABLED=
# How many AI write-ups to publish each morning / return on the feed.
UPDATES_FEED_LIMIT=5
